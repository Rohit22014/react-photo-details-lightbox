{
  "name": "react-photo-details-lightbox",
  "version": "0.1.0",
  "description": "A photography-first metadata inspector for Yet Another React Lightbox.",
  "keywords": [
    "react",
    "nextjs",
    "lightbox",
    "photography",
    "exif",
    "metadata",
    "typescript",
    "accessibility"
  ],
  "author": "Rohit Dina Nath",
  "license": "MIT",
  "homepage": "https://photo-details-lightbox.rohitdinanath.chatgpt.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rohit22014/react-photo-details-lightbox.git",
    "directory": "packages/react-photo-details-lightbox"
  },
  "bugs": {
    "url": "https://github.com/Rohit22014/react-photo-details-lightbox/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./exif": {
      "import": {
        "types": "./dist/exif.d.ts",
        "default": "./dist/exif.js"
      },
      "require": {
        "types": "./dist/exif.d.cts",
        "default": "./dist/exif.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "check:package": "publint --pack false --strict && attw --pack . --entrypoints . ./exif ./package.json --profile node16 && npm pack --dry-run",
    "lint": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm test && npm run check:package",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20",
    "yet-another-react-lightbox": ">=3.21.0 <4"
  },
  "optionalDependencies": {
    "exifr": "^7.1.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^26.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "yet-another-react-lightbox": "3.32.1"
  }
}
