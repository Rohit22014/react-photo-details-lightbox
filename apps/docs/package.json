{
  "name": "@photo-details/docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "build:cloudflare": "next build && opennextjs-cloudflare build --skipNextBuild",
